  "narrative": {
    "northStar": "One Brand, Three Rooms",
    "overview": "The site ships three pinned layouts of the same gym: A Ingresso de festa (blue, yellow tickets, grain), C Noite (near-black, full-bleed photos, lantern), D Contraste (black, grayscale photos that gain colour). Shared: logo mark, blue and yellow, condensed uppercase headlines, direct local voice, and one job per screen: choose a unit and tap WhatsApp. Each world owns one signature interaction, all gated by prefers-reduced-motion.",
    "keyCharacteristics": [
      "Shared yellow #FFC400 as the action colour in all three worlds",
      "Condensed uppercase display faces, calm sans for body",
      "Container-query layout with mobile menu and sticky action bar",
      "Depth only from soft tinted shadows and photography",
      "Unconfirmed data shown as solid yellow chips"
    ],
    "rules": [
      {
        "name": "The Yellow Is Action Rule",
        "body": "Yellow marks what you can tap or what is in focus. It is never wallpaper, except A's ticket stock, which is the object being tapped.",
        "section": "colors"
      },
      {
        "name": "The Pinned Palette Rule",
        "body": "Hex values come from src/data/site.mjs (A) and the layout CSS (C, D). Do not mint new brand hues.",
        "section": "colors"
      },
      {
        "name": "The Own Face Rule",
        "body": "Display and body faces never cross worlds.",
        "section": "typography"
      },
      {
        "name": "The Numerals Rule",
        "body": "Counters and serials use tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Soft Shadow Rule",
        "body": "Shadows are diffuse and tinted to the ground. No hard offset shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the logo lockup, yellow action colour and uppercase condensed headlines identical across worlds.",
      "Do give every world its own faces, radius family and one signature interaction, as built.",
      "Do keep 3px (D 2px) yellow focus outlines and 44px minimum targets.",
      "Do mark unconfirmed facts with the yellow .ph chip.",
      "Do gate every new animation on prefers-reduced-motion."
    ],
    "donts": [
      "Don't use blue as a surface in C or D, or mix a world's type pairing into another.",
      "Don't add hard offset shadows or new brand hues.",
      "Don't invent contact data, prices, ratings or testimonials; unknown stays marked.",
      "Don't make the effects layer carry information; every effect is decoration over a working static page."
    ]
  }
}